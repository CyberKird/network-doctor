{
  "name": "network-doctor",
  "version": "4.0.0",
  "description": "Network diagnostics and repair toolkit for Windows, macOS and Linux",
  "main": "./out/main/index.js",
  "author": "CyberKird",
  "desktopName": "com.cyberkird.networkdoctor",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --packages=external --outdir=out/tests --log-level=warning && node --test \"out/tests/*.test.js\"",
    "start": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
